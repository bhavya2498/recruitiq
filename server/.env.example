PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/recruitiq
# REQUIRED. Use a random string of 32+ characters (mandatory in production):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# NODE_ENV=production

# --- Administrator bootstrap (used only while no active admin exists) ---
# Promote existing accounts by email:
# ADMIN_EMAILS=hr.head@company.com
# ...or create the first admin:
# ADMIN_EMAIL=admin@company.com
# ADMIN_PASSWORD=ChangeMe123
# ADMIN_NAME=Administrator

# Set to false so recruiter accounts can only be created by an admin (candidates can always self-register)
# ALLOW_RECRUITER_SIGNUP=false
# Number of reverse proxies in front of the API (so rate limits use the real client IP)
# TRUST_PROXY=1
# MAX_LOGIN_ATTEMPTS=5
# LOCK_MINUTES=15
